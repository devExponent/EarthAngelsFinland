rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public read for published images/videos (site visitors can view)
    match /public/{allPaths=**} {
      allow read: if true;
      // Only signed-in users (admins) can upload/update/delete
      allow write: if request.auth != null;
    }

    // Block everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
